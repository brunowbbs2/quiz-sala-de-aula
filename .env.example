# Banco de dados Postgres (Neon). OBRIGATÓRIO.
# Copie a "Connection string" do painel do Neon — algo como:
#   postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Senha da área do professor. OBRIGATÓRIA em produção (NODE_ENV=production).
# Sem ela, localmente, o painel abre sem login para facilitar o desenvolvimento.
ADMIN_PASSWORD=

# Opcional: mantém a sessão válida entre reinícios do servidor.
# Se não definir, é derivada da ADMIN_PASSWORD.
SESSION_SECRET=

# Opcional: endereço que os alunos digitam. Vazio = detecta sozinho.
PUBLIC_URL=

# Opcional: tamanho do pool de conexões (o plano grátis do Neon é limitado).
DATABASE_POOL=8

# Porta (a maioria das hospedagens define sozinha)
PORT=3000
