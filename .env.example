# Senha da área do professor. OBRIGATÓRIA em produção (NODE_ENV=production).
# Sem ela, localmente, o painel abre sem login para facilitar o desenvolvimento.
ADMIN_PASSWORD=

# Opcional: mantém a sessão válida entre reinícios do servidor.
# Se não definir, é derivada da ADMIN_PASSWORD.
SESSION_SECRET=

# Banco de dados.
# Vazio  -> arquivo SQLite local em ./data (bom para desenvolvimento ou host com disco)
# Turso  -> libsql://seu-banco.turso.io  (necessário em hosts sem disco persistente)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Endereço que os alunos digitam. Deixe vazio para detectar sozinho.
PUBLIC_URL=

# Porta (a maioria das hospedagens define sozinha)
PORT=3000
